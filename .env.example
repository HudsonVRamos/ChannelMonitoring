# Widevine PoC - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# URL do canal SKY+ para monitorar
POC_CHANNEL_URL=https://www.skyplus.com.br/ao-vivo/canal-exemplo

# Nível de log (DEBUG, INFO, WARNING, ERROR)
POC_LOG_LEVEL=INFO

# Credenciais AWS para Bedrock (necessário para diagnóstico por IA)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
